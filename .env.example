# DefaultGuard Pro - Environment Configuration Example

# ==========================================
# BACKEND CONFIGURES (FastAPI)
# ==========================================
# Host port settings
PORT=8000
HOST=127.0.0.1

# Security parameters (Use a cryptographically secure key in production)
JWT_SECRET_KEY=supersecretbankingkeydefaultdontuseinprod123!
ACCESS_TOKEN_EXPIRE_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Defaults to local SQLite)
DATABASE_URL=sqlite:///./data/loan_system.db

# Cross-Origin Resource Sharing (CORS) Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Production environment toggle
ENV=development

# ==========================================
# FRONTEND CONFIGURES (Vite + React)
# ==========================================
# API Endpoint URL (Tells Vite proxy or Axios where the FastAPI server is located)
VITE_API_URL=http://localhost:8000
